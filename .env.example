# Telegram bot token from @BotFather (REQUIRED)
BOT_TOKEN=123456789:AA-your-token-here

# Comma-separated Telegram user IDs with admin commands (REQUIRED)
ADMIN_IDS=123456789,987654321

# Local Bot API server for 2GB uploads (OPTIONAL - without it downloads cap at 50MB)
TELEGRAM_API_BASE=http://YOUR-BOTAPI-BOX:8081

# YouTube cookies file if you need bot-check/age-restricted fixes (OPTIONAL, see COOKIES.md)
# COOKIES_PATH=/home/user/zaptdl/cookies.txt
